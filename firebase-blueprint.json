{
  "entities": {
    "Election": {
      "title": "Election",
      "description": "Represents an election event and its outcome.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "state": { "type": "string" },
        "type": { "type": "string", "enum": ["state", "central"] },
        "year": { "type": "integer" },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "party": { "type": "string" },
              "seats": { "type": "integer" },
              "votes": { "type": "number" }
            }
          }
        },
        "summary": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "type", "year"]
    },
    "EconomicMetric": {
      "title": "Economic Metric",
      "description": "Tracking stock prices or consumer goods affected by political events.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "category": { "type": "string", "enum": ["stock", "good"] },
        "itemName": { "type": "string" },
        "price": { "type": "number" },
        "change": { "type": "number" },
        "trend": { "type": "string", "enum": ["up", "down", "stable"] },
        "relatedElectionId": { "type": "string" }
      },
      "required": ["id", "category", "itemName", "price"]
    },
    "VerificationUpdate": {
      "title": "Verification Update",
      "description": "Verified news or data updates on a periodic basis.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "content": { "type": "string" },
        "source": { "type": "string" },
        "isVerified": { "type": "boolean" }
      },
      "required": ["id", "content", "timestamp"]
    }
  },
  "firestore": {
    "elections": {
      "schema": "Election",
      "description": "Collection of all state and central elections."
    },
    "economic_metrics": {
      "schema": "EconomicMetric",
      "description": "Real-time or periodic tracking of economic impacts."
    },
    "updates": {
      "schema": "VerificationUpdate",
      "description": "Hourly verified news updates."
    }
  }
}
